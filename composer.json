{
    "name": "nhrrob/secure",
    "description": "WordPress security: login protection, two-factor, firewall, hardening, scanner and an activity log.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Nazmul Hasan Robin",
            "email": "robin.sust08@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=7.4"
    },
    "autoload": {
        "psr-4": {
            "NHRRob\\Secure\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NHRRob\\Secure\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "10up/wp_mock": "^1.1",
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcsstandards/phpcsutils": "^1.0",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha"
    },
    "scripts": {
        "dev": "composer install",
        "build": "composer install --no-dev",
        "test:unit": "phpunit --configuration phpunit.xml",
        "phpcs": "phpcs",
        "phpcbf": "phpcbf"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "7.4.33"
        }
    }
}
